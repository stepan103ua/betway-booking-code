# Copy to .env and fill in. Real values live in the deploy platform's env settings,
# never in the repo. See docs/backend.md §8.

# Betway Nigeria betting API. Pin this host exactly — do NOT use betway.com, which is
# geo-restricted and redirects. See docs/betway-api.md §7.
BETWAY_BASE_URL=https://www.betway.com.ng/appsynapse/bet-api-sr

# Redis connection string (Upstash in production, docker-compose locally).
# Leave empty to run without a cache: every read goes straight upstream.
REDIS_URL=

# Port the HTTP server binds to. Defaults to 3000.
PORT=3000

# Origin allowed by CORS — the web app's URL. Comma-separate for more than one.
# The Flutter client sends no Origin header, so it is unaffected either way.
ALLOWED_ORIGIN=http://localhost:3001
