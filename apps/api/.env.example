# Copy to .env and adjust. Loaded by `dotenv/config` in src/index.ts, which no-ops when the
# file is absent — the service runs on defaults without it.
#
# In production there is no .env: Railway and Fly inject these as real environment variables
# (docs/backend.md §8). Never commit a filled-in .env.

NODE_ENV=development

# Betway Nigeria betting API. Pinned host — never betway.com, which is geo-restricted and
# redirects (docs/betway-api.md §7). Stops at the service root; the provider appends the path.
BETWAY_BASE_URL=https://www.betway.com.ng/appsynapse/bet-api-sr

# Redis connection string. Upstash in production, docker-compose locally (`npm run redis:up`).
# Leave empty or omit to run without a cache — every read then goes straight upstream.
REDIS_URL=redis://localhost:6379

PORT=3000

# Origin allowed by CORS — the web app's URL. Comma-separate for more than one. The Flutter
# client sends no Origin header from a native HTTP client, so it is unaffected either way.
ALLOWED_ORIGIN=http://localhost:3001
