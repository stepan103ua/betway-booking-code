{
  "name": "betway-booking-code",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Decode, create and convert Betway Nigeria booking codes.",
  "engines": {
    "node": ">=20.9"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @booking-code/api",
    "build": "npm run build --workspace @booking-code/api",
    "start": "npm run start --workspace @booking-code/api",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspace @booking-code/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
